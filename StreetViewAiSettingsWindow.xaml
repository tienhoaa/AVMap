<Window x:Class="AVMap.StreetViewAiSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AVMap - Cài Đặt Xử Lý Ảnh Khảo Sát &amp; AI Inpaint" 
        Height="500" Width="700"
        WindowStartupLocation="CenterOwner"
        WindowStyle="SingleBorderWindow"
        ResizeMode="NoResize"
        Background="#18181B"
        Foreground="#F4F4F5"
        FontFamily="Segoe UI">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="🪄" FontSize="22" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="CẤU HÌNH XỬ LÝ ẢNH HIỆN TRƯỜNG &amp; AI" FontSize="16" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="Tự động xóa sạch logo Google &amp; chữ bản quyền, tạo ảnh hiện trường chân thực phục vụ hồ sơ báo cáo khảo sát." 
                       FontSize="11.5" Foreground="#A1A1AA" TextWrapping="Wrap" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Body -->
        <Border Grid.Row="1" Background="#27272A" CornerRadius="8" Padding="16" BorderBrush="#3F3F46" BorderThickness="1">
            <StackPanel>
                <!-- Chế độ xử lý -->
                <TextBlock Text="CHẾ ĐỘ XÓA LOGO &amp; BÙ ĐẮP VÂN MẶT ĐƯỜNG:" FontWeight="Bold" FontSize="12" Foreground="#F59E0B" Margin="0,0,0,8"/>

                <RadioButton x:Name="rbBuiltIn" GroupName="Provider" Content="🌟 Smart Inpaint Cục Bộ (Khuyên dùng - Miễn phí 100%, Không cần mạng &amp; API Key)" 
                             Foreground="#F4F4F5" FontSize="12" IsChecked="True" Checked="Provider_Changed" Margin="0,0,0,6"/>
                <TextBlock Text="   Tự động trích xuất vân nhựa đường/lề đường lân cận bù đắp vào logo trong 0.1s." FontSize="11" Foreground="#71717A" Margin="0,0,0,10"/>

                <RadioButton x:Name="rbClipdrop" GroupName="Provider" Content="🌐 Clipdrop Cleanup API (AI Inpainting siêu thực chuyên nghiệp)" 
                             Foreground="#F4F4F5" FontSize="12" Checked="Provider_Changed" Margin="0,0,0,6"/>
                <RadioButton x:Name="rbGoogle" GroupName="Provider" Content="🌐 Google Cloud AI (Gemini / Imagen 3 API)" 
                             Foreground="#F4F4F5" FontSize="12" Checked="Provider_Changed" Margin="0,0,0,10"/>

                <!-- API Key Box -->
                <Grid x:Name="gridApiKey" Margin="0,0,0,14" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="lblKeyTitle" Text="MÃ API KEY:" FontSize="11" FontWeight="SemiBold" Foreground="#38BDF8" Margin="0,0,0,4"/>
                    <TextBox x:Name="txtApiKey" Grid.Row="1" Height="28" Background="#18181B" Foreground="#38BDF8" BorderBrush="#52525B" 
                             Padding="6,4" FontSize="12" VerticalContentAlignment="Center"/>
                </Grid>

                <Separator Background="#3F3F46" Margin="0,4,0,12"/>

                <!-- Tùy chọn ảnh khảo sát hiện trường -->
                <TextBlock Text="TÙY CHỌN ẢNH KHẢO SÁT HIỆN TRƯỜNG:" FontWeight="Bold" FontSize="12" Foreground="#F59E0B" Margin="0,0,0,8"/>

                <CheckBox x:Name="chkRemoveRoadWatermark" Content="🧹 Tự động xóa mờ vệt chữ bản quyền Google in chìm trên mặt đường" 
                          Foreground="#F4F4F5" FontSize="12" IsChecked="True" Margin="0,0,0,8"/>

                <CheckBox x:Name="chkAddStamp" Content="🏷️ Đóng dấu thông tin tọa độ VN-2000, lý trình &amp; góc nhìn vào góc ảnh" 
                          Foreground="#F4F4F5" FontSize="12" IsChecked="False" Margin="0,0,0,8"/>

                <CheckBox x:Name="chkIncludeTimestamp" Content="🕒 Ghi nhận thêm dòng ngày giờ chụp vào dấu khảo sát (mặc định tắt)" 
                          Foreground="#A1A1AA" FontSize="11.5" IsChecked="False" Margin="20,0,0,8"/>

                <Grid Margin="20,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Tên công trình/dự án:" FontSize="11.5" Foreground="#A1A1AA" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBox x:Name="txtProjectName" Grid.Column="1" Height="26" Background="#18181B" Foreground="#F4F4F5" BorderBrush="#52525B" 
                             Padding="6,3" FontSize="11.5" Text="KHAO SAT TUYEN" VerticalContentAlignment="Center"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="💾 Lưu cài đặt" Width="110" Height="32" Background="#16A34A" Foreground="White" FontWeight="Bold" BorderThickness="0" Margin="0,0,10,0" Click="BtnSave_Click"/>
            <Button Content="Đóng" Width="80" Height="32" Background="#3F3F46" Foreground="White" BorderThickness="0" Click="BtnClose_Click"/>
        </StackPanel>
    </Grid>
</Window>
