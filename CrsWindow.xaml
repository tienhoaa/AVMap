<Window x:Class="AVMap.CrsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Danh mục Hệ tọa độ VN-2000 - AVMap" 
        Height="680" Width="890"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize"
        Background="#F8FAFC"
        FontFamily="Segoe UI" FontSize="13">
    <Grid Margin="15,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- 0: Header Banner -->
            <RowDefinition Height="Auto"/> <!-- 1: Current Active CRS Card -->
            <RowDefinition Height="Auto"/> <!-- 2: BẢNG 1: LỊCH SỬ / ĐÃ DÙNG GẦN ĐÂY -->
            <RowDefinition Height="Auto"/> <!-- 3: Search Bar -->
            <RowDefinition Height="*"/>    <!-- 4: BẢNG 2: TẤT CẢ HỆ TỌA ĐỘ -->
            <RowDefinition Height="Auto"/> <!-- 5: Bottom Buttons -->
        </Grid.RowDefinitions>

        <!-- 0: Header -->
        <Border Grid.Row="0" Background="#0F172A" CornerRadius="8" Padding="16,12" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="🌐" FontSize="26" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <StackPanel>
                    <TextBlock Text="CÀI ĐẶT HỆ TỌA ĐỘ BẢN VẼ (CRS CATALOG)" FontSize="15.5" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Hỗ trợ đầy đủ 34 tỉnh sáp nhập (TT 24/2025/TT-BTNMT), 63 tỉnh truyền thống và Múi chiếu 6° (TM-6)" FontSize="12" Foreground="#94A3B8"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 1: Current Active CRS Indicator Card -->
        <Border Grid.Row="1" x:Name="pnlCurrentCrs" Background="#F0FDF4" BorderBrush="#86EFAC" BorderThickness="1.5" CornerRadius="8" Padding="14,9" Margin="0,0,0,10">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <TextBlock Text="📍" FontSize="20" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="TỈNH THÀNH / HỆ TỌA ĐỘ ĐANG ÁP DỤNG HIỆN TẠI CHO BẢN VẼ:" FontSize="11" FontWeight="Bold" Foreground="#166534"/>
                        <TextBlock x:Name="lblCurrentCrsText" Text="Đang xác định..." FontSize="13" FontWeight="Bold" Foreground="#15803D" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>
                <Border DockPanel.Dock="Right" x:Name="badgeCurrentCrs" Background="#DCFCE7" BorderBrush="#86EFAC" BorderThickness="1" CornerRadius="12" Padding="10,4" VerticalAlignment="Center">
                    <TextBlock x:Name="lblCurrentCrsBadge" Text="✔ ĐANG SỬ DỤNG" FontSize="11" FontWeight="Bold" Foreground="#166534"/>
                </Border>
            </DockPanel>
        </Border>

        <!-- 2: BẢNG 1: LỊCH SỬ / ĐÃ SỬ DỤNG GẦN ĐÂY (RECENTLY USED) -->
        <Border Grid.Row="2" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,10">
            <StackPanel>
                <DockPanel Margin="2,0,2,6">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                        <TextBlock Text="🕒" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="HỆ TỌA ĐỘ ĐÃ SỬ DỤNG GẦN ĐÂY (LỊCH SỬ)" FontWeight="Bold" FontSize="12" Foreground="#0369A1"/>
                    </StackPanel>
                    <TextBlock Text="(Click đúp để chọn ngay)" FontStyle="Italic" FontSize="11" Foreground="#64748B" DockPanel.Dock="Right"/>
                </DockPanel>

                <DataGrid x:Name="dgRecent" AutoGenerateColumns="False" IsReadOnly="True"
                          MaxHeight="125" SelectionMode="Single" HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9"
                          RowBackground="White" AlternatingRowBackground="#F8FAFC"
                          BorderThickness="1" BorderBrush="#E2E8F0"
                          MouseDoubleClick="DgRecent_MouseDoubleClick" SelectionChanged="DgRecent_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Mã EPSG" Binding="{Binding EpsgCode}" Width="75" FontWeight="SemiBold"/>
                        <DataGridTextColumn Header="Tên hệ tọa độ" Binding="{Binding Name}" Width="230"/>
                        <DataGridTextColumn Header="Tỉnh thành" Binding="{Binding Province}" Width="180"/>
                        <DataGridTextColumn Header="Múi chiếu" Binding="{Binding ZoneText}" Width="105" FontWeight="SemiBold" Foreground="#0284C7"/>
                        <DataGridTextColumn Header="KTT" Binding="{Binding CentralMeridian, StringFormat='{}{0}°'}" Width="65" FontWeight="Bold"/>
                        <DataGridTextColumn Header="Mô tả &amp; Chi tiết" Binding="{Binding Description}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Border>

        <!-- 3: Search Bar & Filter -->
        <Grid Grid.Row="3" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="txtSearch" Height="34" VerticalContentAlignment="Center" Padding="8,0"
                     Text="" TextChanged="TxtSearch_TextChanged"
                     BorderBrush="#94A3B8" Background="White"/>
            <TextBlock IsHitTestVisible="False" Text="🔍 Nhập tên tỉnh, mã EPSG, KTT hoặc '6 độ' / 'TM-6' (VD: Khánh Hòa, Hà Nội, Vĩnh Long, 108.25, 3405, TM-6)..."
                       VerticalAlignment="Center" Margin="10,0,0,0" Foreground="#94A3B8">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Text, ElementName=txtSearch}" Value="">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>

        <!-- 4: BẢNG 2: TẤT CẢ HỆ TỌA ĐỘ VN-2000 -->
        <Border Grid.Row="4" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="10,8">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="2,0,2,6">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                        <TextBlock Text="📋" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="TẤT CẢ TỈNH THÀNH &amp; HỆ TỌA ĐỘ VN-2000 (DANH MỤC ĐẦY ĐỦ)" FontWeight="Bold" FontSize="12" Foreground="#334155"/>
                    </StackPanel>
                    <TextBlock x:Name="lblCountInfo" Text="Đang tải..." FontStyle="Italic" FontSize="11" Foreground="#64748B" DockPanel.Dock="Right"/>
                </DockPanel>

                <DataGrid x:Name="dgCrs" AutoGenerateColumns="False" IsReadOnly="True"
                          SelectionMode="Single" HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9"
                          RowBackground="White" AlternatingRowBackground="#F8FAFC"
                          BorderThickness="1" BorderBrush="#E2E8F0"
                          MouseDoubleClick="DgCrs_MouseDoubleClick" SelectionChanged="DgCrs_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Mã EPSG" Binding="{Binding EpsgCode}" Width="75" FontWeight="SemiBold"/>
                        <DataGridTextColumn Header="Tên hệ tọa độ" Binding="{Binding Name}" Width="230"/>
                        <DataGridTextColumn Header="Tỉnh thành áp dụng" Binding="{Binding Province}" Width="190"/>
                        <DataGridTextColumn Header="Múi chiếu" Binding="{Binding ZoneText}" Width="105" FontWeight="SemiBold" Foreground="#0284C7"/>
                        <DataGridTextColumn Header="KTT" Binding="{Binding CentralMeridian, StringFormat='{}{0}°'}" Width="65" FontWeight="Bold"/>
                        <DataGridTextColumn Header="Mô tả &amp; Chi tiết áp dụng" Binding="{Binding Description}" Width="*"/>
                        <DataGridTextColumn Header="Trạng thái" Binding="{Binding StatusText}" Width="100" FontWeight="Bold" Foreground="#16A34A"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <!-- 5: Bottom Buttons -->
        <DockPanel Grid.Row="5" Margin="0,12,0,0" LastChildFill="False">
            <TextBlock x:Name="lblStatus" Text="Đã nạp danh mục chuẩn VN-2000" VerticalAlignment="Center" Foreground="#64748B" FontSize="12"/>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button Content="Hủy bỏ" Width="95" Height="35" Margin="0,0,10,0" Background="#E2E8F0" BorderThickness="0" Click="BtnCancel_Click" Cursor="Hand"/>
                <Button Content="✔ Chọn Hệ Tọa Độ Này" Width="175" Height="35" Background="#0284C7" Foreground="White" FontWeight="Bold" BorderThickness="0" Click="BtnSelect_Click" Cursor="Hand"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
