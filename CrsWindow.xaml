<Window x:Class="AVMap.CrsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Danh mục Hệ tọa độ VN-2000 - AVMap" 
        Height="590" Width="820"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize"
        Background="#F5F6F8"
        FontFamily="Segoe UI" FontSize="13">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#1E293B" CornerRadius="6" Padding="15,12" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="🌐" FontSize="24" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <StackPanel>
                    <TextBlock Text="CÀI ĐẶT HỆ TỌA ĐỘ BẢN VẼ (CRS CATALOG)" FontSize="16" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Chọn đúng tỉnh thành / kinh tuyến trục VN-2000 để bản đồ nền và KMZ khớp chính xác" FontSize="12" Foreground="#94A3B8"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Current Active CRS Indicator Card -->
        <Border Grid.Row="1" x:Name="pnlCurrentCrs" Background="#F0FDF4" BorderBrush="#86EFAC" BorderThickness="1.5" CornerRadius="6" Padding="14,10" Margin="0,0,0,10">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <TextBlock Text="📍" FontSize="20" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="TỈNH THÀNH / HỆ TỌA ĐỘ ĐANG ÁP DỤNG HIỆN TẠI CHO BẢN VẼ:" FontSize="11" FontWeight="Bold" Foreground="#166534"/>
                        <TextBlock x:Name="lblCurrentCrsText" Text="Đang xác định..." FontSize="13" FontWeight="Bold" Foreground="#15803D" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>
                <Border DockPanel.Dock="Right" x:Name="badgeCurrentCrs" Background="#DCFCE7" BorderBrush="#86EFAC" BorderThickness="1" CornerRadius="12" Padding="10,4" VerticalAlignment="Center">
                    <TextBlock x:Name="lblCurrentCrsBadge" Text="✔ ĐANG SỬ DỤNG" FontSize="11" FontWeight="Bold" Foreground="#166534"/>
                </Border>
            </DockPanel>
        </Border>

        <!-- Search Bar & Filter -->
        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="txtSearch" Height="34" VerticalContentAlignment="Center" Padding="8,0"
                     Text="" TextChanged="TxtSearch_TextChanged"
                     BorderBrush="#CBD5E1" Background="White"/>
            <TextBlock IsHitTestVisible="False" Text="🔍 Nhập tên tỉnh, mã EPSG hoặc kinh tuyến trục (VD: Khánh Hòa, Vĩnh Long, Hà Nội, 105.5, 9254)..."
                       VerticalAlignment="Center" Margin="10,0,0,0" Foreground="#94A3B8">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Text, ElementName=txtSearch}" Value="">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>

        <!-- Data Grid -->
        <Border Grid.Row="3" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4">
            <DataGrid x:Name="dgCrs" AutoGenerateColumns="False" IsReadOnly="True"
                      SelectionMode="Single" HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9"
                      RowBackground="White" AlternatingRowBackground="#F8FAFC"
                      BorderThickness="0" MouseDoubleClick="DgCrs_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Mã EPSG" Binding="{Binding EpsgCode}" Width="75" FontWeight="SemiBold"/>
                    <DataGridTextColumn Header="Tên hệ tọa độ" Binding="{Binding Name}" Width="190"/>
                    <DataGridTextColumn Header="Tỉnh thành áp dụng" Binding="{Binding Province}" Width="210"/>
                    <DataGridTextColumn Header="KTT" Binding="{Binding CentralMeridian, StringFormat='{}{0}°'}" Width="70"/>
                    <DataGridTextColumn Header="Mô tả" Binding="{Binding Description}" Width="*"/>
                    <DataGridTextColumn Header="Trạng thái" Binding="{Binding StatusText}" Width="110" FontWeight="Bold" Foreground="#16A34A"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Bottom Buttons -->
        <DockPanel Grid.Row="4" Margin="0,15,0,0" LastChildFill="False">
            <TextBlock x:Name="lblStatus" Text="Đã nạp 67 hệ tọa độ chuẩn Việt Nam" VerticalAlignment="Center" Foreground="#64748B"/>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button Content="Hủy bỏ" Width="90" Height="34" Margin="0,0,10,0" Background="#E2E8F0" BorderThickness="0" Click="BtnCancel_Click"/>
                <Button Content="✔ Chọn Hệ Tọa Độ" Width="150" Height="34" Background="#0284C7" Foreground="White" FontWeight="Bold" BorderThickness="0" Click="BtnSelect_Click"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
