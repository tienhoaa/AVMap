<Window x:Class="AVMap.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hướng Dẫn Sử Dụng Tiện Ích AVMap" 
        Height="580" Width="800"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow"
        ResizeMode="NoResize"
        Background="#F8FAFC"
        FontFamily="Segoe UI" FontSize="13">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#0F172A" CornerRadius="8" Padding="16,12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Image Grid.Column="0" x:Name="imgLogo" Width="42" Height="42" Margin="0,0,14,0" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="AVMAP - BẢN ĐỒ NỀN &amp; GIS CAD (VN-2000)" FontWeight="Bold" FontSize="16" Foreground="White"/>
                    <TextBlock Text="Đã nạp thành công! Tra cứu nhanh tính năng, phím lệnh và hướng dẫn sử dụng" FontSize="12" Foreground="#94A3B8" Margin="0,3,0,0"/>
                </StackPanel>
                <Border Grid.Column="2" Background="#1E293B" CornerRadius="4" Padding="8,4" VerticalAlignment="Center">
                    <TextBlock Text="Phiên Bản v27" FontSize="11" FontWeight="Bold" Foreground="#38BDF8"/>
                </Border>
            </Grid>
        </Border>

        <!-- Body Tabs -->
        <TabControl Grid.Row="1" Margin="0,0,0,12" Background="White" BorderBrush="#CBD5E1">
            <!-- Tab 1: Khởi động nhanh -->
            <TabItem Header=" 🚀 Bắt Đầu Nhanh " FontWeight="SemiBold">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                    <StackPanel>
                        <TextBlock Text="3 BƯỚC ĐỂ BẬT BẢN ĐỒ NỀN VỆ TINH TRÊN BẢN VẼ CAD:" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,12"/>

                        <!-- Bước 1 -->
                        <Border Background="#F1F5F9" CornerRadius="6" Padding="12" Margin="0,0,0,10" BorderBrush="#E2E8F0" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="26" Height="26" Background="#0284C7" CornerRadius="13" VerticalAlignment="Top">
                                    <TextBlock Text="1" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Cài đặt Hệ tọa độ VN-2000 cho bản vẽ (Lệnh: AVCRS)" FontWeight="Bold" Foreground="#0284C7"/>
                                    <TextBlock Text="Bấm nút [Hệ Tọa Độ VN-2000] trên thanh Ribbon hoặc gõ lệnh AVCRS. Tìm kiếm tỉnh thành nơi thi công công trình (Hà Nội, TP.HCM, Thủ Đức, Gia Lai 108°30', Huế,...), chọn múi 3° hoặc 6° rồi bấm Áp dụng." TextWrapping="Wrap" Margin="0,3,0,0" Foreground="#475569"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Bước 2 -->
                        <Border Background="#F1F5F9" CornerRadius="6" Padding="12" Margin="0,0,0,10" BorderBrush="#E2E8F0" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="26" Height="26" Background="#16A34A" CornerRadius="13" VerticalAlignment="Top">
                                    <TextBlock Text="2" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Bật bản đồ nền vệ tinh Realtime (Lệnh: AVMAPON)" FontWeight="Bold" Foreground="#16A34A"/>
                                    <TextBlock Text="Bấm nút [Bật Nền (Show)] hoặc gõ AVMAPON. Ảnh vệ tinh Google Maps độ nét cao sẽ tự động nạp chính xác 100% theo đúng tọa độ công trình. Khi zoom hoặc lia chuột, bản đồ tự động tải bổ sung mượt mà." TextWrapping="Wrap" Margin="0,3,0,0" Foreground="#475569"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Bước 3 -->
                        <Border Background="#F1F5F9" CornerRadius="6" Padding="12" Margin="0,0,0,6" BorderBrush="#E2E8F0" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="26" Height="26" Background="#EA580C" CornerRadius="13" VerticalAlignment="Top">
                                    <TextBlock Text="3" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Tắt nền khi in ấn hoặc hoàn thành (Lệnh: AVMAPOFF)" FontWeight="Bold" Foreground="#EA580C"/>
                                    <TextBlock Text="Bấm nút [Ẩn Nền (Hide)] hoặc gõ AVMAPOFF để làm sạch bản vẽ trở lại bình thường. Bạn cũng có thể dùng lệnh AVCLEAN để dọn sạch toàn bộ file rác tạm bất cứ lúc nào." TextWrapping="Wrap" Margin="0,3,0,0" Foreground="#475569"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Tab 2: Danh sách lệnh -->
            <TabItem Header=" 📋 Bảng Tra Cứu Lệnh " FontWeight="SemiBold">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Row 0: AVCRS -->
                        <Border Grid.Row="0" Grid.Column="0" Background="#F8FAFC" Padding="8" BorderBrush="#E2E8F0" BorderThickness="0,0,1,1">
                            <TextBlock Text="AVCRS" FontWeight="Bold" Foreground="#0284C7"/>
                        </Border>
                        <Border Grid.Row="0" Grid.Column="1" Padding="8" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                            <TextBlock Text="Mở bảng cài đặt Hệ tọa độ &amp; Kinh tuyến trục VN-2000 cho bản vẽ" Foreground="#334155"/>
                        </Border>

                        <!-- Row 1: AVMAPON / AVMAPOFF -->
                        <Border Grid.Row="1" Grid.Column="0" Background="#F8FAFC" Padding="8" BorderBrush="#E2E8F0" BorderThickness="0,0,1,1">
                            <TextBlock Text="AVMAPON / AVMAPOFF" FontWeight="Bold" Foreground="#0284C7"/>
                        </Border>
                        <Border Grid.Row="1" Grid.Column="1" Padding="8" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                            <TextBlock Text="Bật / Tắt tải bản đồ nền vệ tinh Google Maps thời gian thực" Foreground="#334155"/>
                        </Border>

                        <!-- Row 2: AVMAPTYPE -->
                        <Border Grid.Row="2" Grid.Column="0" Background="#F8FAFC" Padding="8" BorderBrush="#E2E8F0" BorderThickness="0,0,1,1">
                            <TextBlock Text="AVMAPTYPE" FontWeight="Bold" Foreground="#0284C7"/>
                        </Border>
                        <Border Grid.Row="2" Grid.Column="1" Padding="8" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                            <TextBlock Text="Đổi nguồn bản đồ: Vệ tinh, Giao thông, Địa hình, Hybrid" Foreground="#334155"/>
                        </Border>

                        <!-- Row 3: AVGETVECTORDATA -->
                        <Border Grid.Row="3" Grid.Column="0" Background="#F8FAFC" Padding="8" BorderBrush="#E2E8F0" BorderThickness="0,0,1,1">
                            <TextBlock Text="AVGETVECTORDATA" FontWeight="Bold" Foreground="#0284C7"/>
                        </Border>
                        <Border Grid.Row="3" Grid.Column="1" Padding="8" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                            <TextBlock Text="Bóc tách bình đồ vector (nhà cửa 2D/3D, nhãn tầng G, tim đường, ranh thửa)" Foreground="#334155"/>
                        </Border>

                        <!-- Row 4: AVCONTOUR -->
                        <Border Grid.Row="4" Grid.Column="0" Background="#F8FAFC" Padding="8" BorderBrush="#E2E8F0" BorderThickness="0,0,1,1">
                            <TextBlock Text="AVCONTOUR" FontWeight="Bold" Foreground="#0284C7"/>
                        </Border>
                        <Border Grid.Row="4" Grid.Column="1" Padding="8" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                            <TextBlock Text="Sinh đường đồng mức địa hình cao độ Z từ dữ liệu DEM toàn cầu" Foreground="#334155"/>
                        </Border>

                        <!-- Row 5: AVSTREETVIEW -->
                        <Border Grid.Row="5" Grid.Column="0" Background="#F8FAFC" Padding="8" BorderBrush="#E2E8F0" BorderThickness="0,0,1,1">
                            <TextBlock Text="AVSTREETVIEW" FontWeight="Bold" Foreground="#0284C7"/>
                        </Border>
                        <Border Grid.Row="5" Grid.Column="1" Padding="8" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                            <TextBlock Text="Click chuột vào tim đường để xem ảnh toàn cảnh 360° Google Street View" Foreground="#334155"/>
                        </Border>

                        <!-- Row 6: AVEXPORTKMZ / AVIMPORTKMZ -->
                        <Border Grid.Row="6" Grid.Column="0" Background="#F8FAFC" Padding="8" BorderBrush="#E2E8F0" BorderThickness="0,0,1,1">
                            <TextBlock Text="AVEXPORTKMZ / AVIMPORTKMZ" FontWeight="Bold" Foreground="#0284C7"/>
                        </Border>
                        <Border Grid.Row="6" Grid.Column="1" Padding="8" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                            <TextBlock Text="Đồng bộ hai chiều với Google Earth (xuất mốc tuyến hoặc lấy ranh về CAD)" Foreground="#334155"/>
                        </Border>

                        <!-- Row 7: AVCLEAN -->
                        <Border Grid.Row="7" Grid.Column="0" Background="#F8FAFC" Padding="8" BorderBrush="#E2E8F0" BorderThickness="0,0,1,1">
                            <TextBlock Text="AVCLEAN" FontWeight="Bold" Foreground="#0284C7"/>
                        </Border>
                        <Border Grid.Row="7" Grid.Column="1" Padding="8" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                            <TextBlock Text="Quét dọn sạch sẽ toàn bộ file tạm và giải phóng ổ cứng (Cache = 0 MB)" Foreground="#334155"/>
                        </Border>

                        <!-- Row 8: AVFIX -->
                        <Border Grid.Row="8" Grid.Column="0" Background="#F8FAFC" Padding="8" BorderBrush="#E2E8F0" BorderThickness="0,0,1,0">
                            <TextBlock Text="AVFIX (AVFILEDIA)" FontWeight="Bold" Foreground="#0284C7"/>
                        </Border>
                        <Border Grid.Row="8" Grid.Column="1" Padding="8">
                            <TextBlock Text="Khôi phục lại hộp thoại mở/lưu file của CAD nếu bị mất (FILEDIA = 1)" Foreground="#334155"/>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- Tab 3: Lưu ý quan trọng -->
            <TabItem Header=" 💡 Mẹo &amp; Lưu Ý " FontWeight="SemiBold">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                    <StackPanel>
                        <Border Background="#FEF3C7" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="⚠️ TỌA ĐỘ BẢN VẼ PHẢI CHUẨN VN-2000" FontWeight="Bold" Foreground="#92400E"/>
                                <TextBlock Text="Bản đồ nền vệ tinh chỉ hiển thị chính xác khi bản vẽ của bạn được vẽ đúng hệ tọa độ thực tế. Nếu màn hình ở gốc (0,0), hãy dùng lệnh ZOOM -> E (Zoom Extents) để đưa góc nhìn về khu vực tim tuyến dự án." TextWrapping="Wrap" Margin="0,4,0,0" Foreground="#78350F"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="🌐 KẾT NỐI INTERNET" FontWeight="Bold" Foreground="#1E40AF"/>
                                <TextBlock Text="Máy tính cần có kết nối mạng Internet để tải ảnh vệ tinh Google Maps và dữ liệu cao độ địa hình DEM toàn cầu." TextWrapping="Wrap" Margin="0,4,0,0" Foreground="#1E3A8A"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="6" Padding="12">
                            <StackPanel>
                                <TextBlock Text="🧹 TỰ ĐỘNG DỌN DẸP CACHE" FontWeight="Bold" Foreground="#166534"/>
                                <TextBlock Text="Hệ thống tự động xóa sạch file ảnh ghép cũ khi zoom/pan và dọn sạch toàn bộ khi bạn đóng tab bản vẽ hoặc thoát CAD, tuyệt đối không gây nặng ổ C." TextWrapping="Wrap" Margin="0,4,0,0" Foreground="#14532D"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Footer -->
        <DockPanel Grid.Row="2" LastChildFill="False">
            <CheckBox x:Name="chkShowOnStartup" Content="Tự động hiện bảng hướng dẫn này mỗi khi nạp AVMap (NETLOAD)" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#475569" IsChecked="True"/>
            <Button Content="🚀 Bắt Đầu Sử Dụng" DockPanel.Dock="Right" Height="34" Padding="20,0" Background="#0284C7" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="BtnClose_Click"/>
        </DockPanel>
    </Grid>
</Window>
