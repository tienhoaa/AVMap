<Window x:Class="AVMap.ToastNotificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AVMap Thông Báo Cập Nhật" 
        Height="105" Width="380"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        Cursor="Hand"
        FontFamily="Segoe UI">
    <Border Background="#0F172A" BorderBrush="#3B82F6" BorderThickness="1.5" CornerRadius="12" Margin="5" Padding="14,10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="12" ShadowDepth="3" Opacity="0.45" Color="Black"/>
        </Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Icon chuông vàng -->
            <TextBlock Grid.Column="0" Text="🔔" FontSize="26" VerticalAlignment="Center" Margin="0,0,12,0"/>

            <!-- Nội dung thông báo -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="AVMap: CÓ BẢN MỚI " FontSize="12.5" FontWeight="Bold" Foreground="#38BDF8"/>
                    <TextBlock x:Name="txtVersion" Text="(v1.2.0)" FontSize="12.5" FontWeight="Bold" Foreground="#4ADE80"/>
                </StackPanel>
                <TextBlock Text="Bấm vào đây để xem chi tiết &amp; cập nhật ngay" FontSize="11" Foreground="#94A3B8" Margin="0,3,0,0"/>
            </StackPanel>

            <!-- Nút tắt x -->
            <Button Grid.Column="2" Content="✕" Width="22" Height="22" VerticalAlignment="Top" HorizontalAlignment="Right"
                    Background="Transparent" Foreground="#64748B" BorderThickness="0" FontSize="12" FontWeight="Bold"
                    Cursor="Hand" Click="BtnClose_Click"/>
        </Grid>
    </Border>
</Window>