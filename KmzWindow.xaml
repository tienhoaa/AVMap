<Window x:Class="AVMap.KmzWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chuyển đổi Google Earth (KMZ / KML) - AVMap Pro" 
        Height="670" Width="820"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow"
        ResizeMode="NoResize"
        Background="#F8FAFC"
        FontFamily="Segoe UI" FontSize="13">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#0F172A" CornerRadius="8" Padding="16,12" Margin="0,0,0,12">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <TextBlock Text="🌍" FontSize="26" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <StackPanel>
                        <TextBlock Text="XUẤT / NHẬP DỮ LIỆU GOOGLE EARTH (KMZ / KML)" FontWeight="Bold" FontSize="15" Foreground="White"/>
                        <TextBlock Text="Chuyển đổi 2 chiều giữa AutoCAD &amp; Google Earth chuẩn VN-2000, bảo toàn Layer, Màu sắc &amp; Hatch" FontSize="12" Foreground="#94A3B8" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>
                <Border DockPanel.Dock="Right" Background="#1E293B" CornerRadius="4" Padding="10,6" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Hệ tọa độ: " Foreground="#94A3B8" FontSize="12"/>
                        <TextBlock x:Name="lblActiveCrs" Text="VN-2000" FontWeight="Bold" Foreground="#38BDF8" FontSize="12"/>
                        <Button Content="Đổi..." Margin="8,0,0,0" Padding="6,1" Background="#0284C7" Foreground="White" BorderThickness="0" FontSize="11" Click="BtnChangeCrs_Click" Cursor="Hand"/>
                    </StackPanel>
                </Border>
            </DockPanel>
        </Border>

        <!-- Main TabControl -->
        <TabControl x:Name="tabMain" Grid.Row="1" Background="Transparent" BorderBrush="#CBD5E1">
            <!-- TAB 1: XUẤT SANG GOOGLE EARTH -->
            <TabItem Header=" 📤 Xuất sang Google Earth (KMZ / KML) " FontWeight="SemiBold">
                <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1,0,1,1" Padding="14">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- 1. Phạm vi đối tượng xuất -->
                            <TextBlock Text="1. PHẠM VI ĐỐI TƯỢNG XUẤT" FontWeight="Bold" Foreground="#1E293B" FontSize="12" Margin="0,0,0,6"/>
                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,12">
                                <StackPanel>
                                    <RadioButton x:Name="rbScopeAll" Content="Toàn bộ bản vẽ (Tất cả đối tượng trong ModelSpace)" IsChecked="True" Margin="0,0,0,8" Checked="RbScope_Changed"/>
                                    <StackPanel Margin="0,0,0,8">
                                        <RadioButton x:Name="rbScopeSelection" Content="Theo đối tượng đang chọn hoặc quét chọn trên CAD" Margin="0,0,0,6" Checked="RbScope_Changed"/>
                                        <StackPanel Orientation="Horizontal" Margin="20,0,0,0">
                                            <Button x:Name="btnPick2Points" Content="📐 Quét 2 Điểm (Không Cần Enter)" Padding="10,4" Background="#0284C7" Foreground="White" FontWeight="SemiBold" BorderThickness="0" Click="BtnPick2Points_Click" Cursor="Hand" Margin="0,0,10,0"/>
                                            <Button x:Name="btnPickObjects" Content="🖱️ Chọn Từng Đối Tượng" Padding="10,4" Background="#E2E8F0" Foreground="#334155" BorderThickness="0" Click="BtnPickObjects_Click" Cursor="Hand"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <RadioButton x:Name="rbScopeLayers" Content="Lọc theo danh sách Layer chỉ định" Margin="0,0,0,6" Checked="RbScope_Changed"/>
                                    
                                    <!-- Layer List Panel -->
                                    <Border x:Name="pnlLayerList" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Height="120" Margin="20,4,0,0" Visibility="Collapsed">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>
                                            <Border Grid.Row="0" Background="#F1F5F9" Padding="6,4">
                                                <DockPanel>
                                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                                        <Button Content="Chọn tất cả" FontSize="11" Padding="6,2" Margin="0,0,6,0" Click="BtnSelectAllLayers_Click"/>
                                                        <Button Content="Bỏ chọn tất cả" FontSize="11" Padding="6,2" Click="BtnDeselectAllLayers_Click"/>
                                                    </StackPanel>
                                                    <TextBlock x:Name="lblLayerCount" Text="0 layers" HorizontalAlignment="Right" FontSize="11" Foreground="#64748B" VerticalAlignment="Center"/>
                                                </DockPanel>
                                            </Border>
                                            <ListBox x:Name="lstLayers" Grid.Row="1" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <CheckBox IsChecked="{Binding IsSelected}" Margin="2">
                                                            <StackPanel Orientation="Horizontal">
                                                                <Border Width="12" Height="12" CornerRadius="6" Background="{Binding ColorHex}" Margin="0,0,8,0" VerticalAlignment="Center" BorderBrush="#94A3B8" BorderThickness="1"/>
                                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </CheckBox>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- 2. Tùy chọn hiển thị & Màu sắc -->
                            <TextBlock Text="2. TÙY CHỌN HIỂN THỊ TRÊN GOOGLE EARTH" FontWeight="Bold" Foreground="#1E293B" FontSize="12" Margin="0,0,0,6"/>
                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <CheckBox x:Name="chkGroupLayers" Content="Tạo Folder theo từng Layer CAD" IsChecked="True" Margin="0,0,0,8"/>
                                        <CheckBox x:Name="chkPreserveColor" Content="Bảo toàn 100% màu sắc gốc từ CAD" IsChecked="True" Margin="0,0,0,8"/>
                                        <CheckBox x:Name="chkHatchTransparent" Content="Xuất Hatch với độ trong suốt 50%" IsChecked="True" Margin="0,0,0,4"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <CheckBox x:Name="chkAutoBrighten" Content="Làm sáng nét đen/tối để nổi trên ảnh vệ tinh" IsChecked="True" Margin="0,0,0,8"/>
                                        <DockPanel Margin="0,0,0,4">
                                            <TextBlock Text="Độ dày nét viền: " VerticalAlignment="Center" Foreground="#475569"/>
                                            <ComboBox x:Name="cboLineWidth" Width="120" HorizontalAlignment="Left">
                                                <ComboBoxItem Content="1.5 px (Thanh mảnh)"/>
                                                <ComboBoxItem Content="2.0 px"/>
                                                <ComboBoxItem Content="2.5 px (Chuẩn)" IsSelected="True"/>
                                                <ComboBoxItem Content="3.0 px (Đậm)"/>
                                                <ComboBoxItem Content="4.0 px (Rất đậm)"/>
                                            </ComboBox>
                                        </DockPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- 3. Tệp lưu KMZ -->
                            <TextBlock Text="3. ĐƯỜNG DẪN TỆP KMZ / KML" FontWeight="Bold" Foreground="#1E293B" FontSize="12" Margin="0,0,0,6"/>
                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="txtExportPath" Grid.Column="0" Height="30" VerticalContentAlignment="Center" Padding="8,0" Foreground="#1E293B"/>
                                        <Button Grid.Column="2" Content="📁 Duyệt..." Height="30" Padding="16,0" Background="#E2E8F0" BorderThickness="0" Click="BtnBrowseExport_Click" Cursor="Hand"/>
                                    </Grid>
                                    <CheckBox x:Name="chkAutoOpenEarth" Content="🚀 Tự động mở Google Earth ngay sau khi xuất xong" IsChecked="True"/>
                                </StackPanel>
                            </Border>

                            <!-- Action Button -->
                            <Button Content="📤 BẮT ĐẦU XUẤT GOOGLE EARTH (KMZ)" Height="40" Background="#0284C7" Foreground="White" FontWeight="Bold" FontSize="14" BorderThickness="0" Click="BtnStartExport_Click" Cursor="Hand" Margin="0,5,0,0"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </TabItem>

            <!-- TAB 2: NHẬP TỪ GOOGLE EARTH -->
            <TabItem Header=" 📥 Nhập từ Google Earth vào CAD " FontWeight="SemiBold">
                <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1,0,1,1" Padding="14">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- 1. Tệp KMZ / KML nguồn -->
                            <TextBlock Text="1. CHỌN TỆP GOOGLE EARTH (KMZ HOẶC KML)" FontWeight="Bold" Foreground="#1E293B" FontSize="12" Margin="0,0,0,6"/>
                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,12">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="txtImportPath" Grid.Column="0" Height="30" VerticalContentAlignment="Center" Padding="8,0" Foreground="#1E293B"/>
                                        <Button Grid.Column="2" Content="📁 Chọn Tệp..." Height="30" Padding="16,0" Background="#0284C7" Foreground="White" FontWeight="Bold" BorderThickness="0" Click="BtnBrowseImport_Click" Cursor="Hand"/>
                                    </Grid>
                                    <TextBlock x:Name="lblImportInfo" Text="Chưa chọn tệp nào. Hỗ trợ tệp ranh quy hoạch, tim tuyến, mốc GPS từ Google Earth / Google My Maps." FontSize="11.5" Foreground="#64748B"/>
                                </StackPanel>
                            </Border>

                            <!-- 2. Tùy chọn tạo đối tượng trong AutoCAD -->
                            <TextBlock Text="2. TÙY CHỌN TẠO ĐỐI TƯỢNG VÀ LAYER TRONG CAD" FontWeight="Bold" Foreground="#1E293B" FontSize="12" Margin="0,0,0,6"/>
                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,12">
                                <StackPanel>
                                    <RadioButton x:Name="rbImportKeepFolders" Content="Tạo Layer tự động theo tên Thư mục / Đối tượng trong KML" IsChecked="True" Margin="0,0,0,8"/>
                                    <DockPanel Margin="0,0,0,10">
                                        <RadioButton x:Name="rbImportSingleLayer" Content="Gom tất cả vào một Layer duy nhất: " VerticalAlignment="Center"/>
                                        <TextBox x:Name="txtSingleLayer" Text="GOOGLE_EARTH_IMPORT" Width="200" Height="26" VerticalContentAlignment="Center" Padding="6,0" HorizontalAlignment="Left" Margin="10,0,0,0"/>
                                    </DockPanel>
                                    <Separator Margin="0,0,0,10" Background="#E2E8F0"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <CheckBox x:Name="chkImportColors" Content="Giữ nguyên màu sắc từ Google Earth" IsChecked="True" Margin="0,0,0,8"/>
                                            <CheckBox x:Name="chkImportClosed" Content="Tự động đóng kín vùng Polygon" IsChecked="True" Margin="0,0,0,4"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <CheckBox x:Name="chkImportLabels" Content="Tạo chữ (Text) ghi tên điểm mốc Placemark" IsChecked="True" Margin="0,0,0,8"/>
                                            <CheckBox x:Name="chkZoomExtents" Content="Tự động Zoom Extents đến vùng vừa nhập" IsChecked="True" Margin="0,0,0,4"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Action Button -->
                            <Button Content="📥 BẮT ĐẦU NHẬP VÀO CAD (CHUYỂN SANG VN-2000)" Height="40" Background="#16A34A" Foreground="White" FontWeight="Bold" FontSize="14" BorderThickness="0" Click="BtnStartImport_Click" Cursor="Hand" Margin="0,10,0,0"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </TabItem>
        </TabControl>

        <!-- Footer -->
        <DockPanel Grid.Row="2" Margin="0,10,0,0" LastChildFill="False">
            <TextBlock Text="⚡ AVMap Pro - Hệ thống xử lý không gian trắc địa &amp; GIS" Foreground="#94A3B8" FontSize="11.5" VerticalAlignment="Center" DockPanel.Dock="Left"/>
            <Button Content="Đóng" Width="90" Height="30" Background="#E2E8F0" BorderThickness="0" Click="BtnClose_Click" Cursor="Hand" DockPanel.Dock="Right"/>
        </DockPanel>
    </Grid>
</Window>