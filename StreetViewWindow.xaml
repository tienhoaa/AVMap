<Window x:Class="AVMap.StreetViewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="AVMap - Google Street View 360° Toàn Cảnh" 
        Height="680" Width="1050"
        WindowState="Normal"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow"
        Background="#18181B"
        FontFamily="Segoe UI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header Bar -->
        <Border Grid.Row="0" Background="#27272A" Padding="12,8" BorderBrush="#3F3F46" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Grid.Column="0">
                    <TextBlock Text="🧍" FontSize="20" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="GOOGLE STREET VIEW 360°" FontWeight="Bold" FontSize="14" Foreground="#F4F4F5" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock x:Name="lblCoordinates" Text="Tọa độ: Đang tải..." 
                               HorizontalAlignment="Center" Foreground="#E4E4E7" FontSize="12" FontWeight="SemiBold"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,0">
                        <Border Background="#064E3B" CornerRadius="3" Padding="4,1" Margin="0,0,6,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="6" Height="6" Fill="#4ADE80" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Đồng bộ CAD" FontSize="10" FontWeight="Bold" Foreground="#86EFAC" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="lblHeadingInfo" Text="Góc nhìn: 0° (Bắc)" Foreground="#38BDF8" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Grid.Column="2">
                    <Button x:Name="btnCapture" Content="📸 Chụp Ảnh Hiện Trạng" Padding="14,6" Background="#059669" Foreground="White" FontWeight="Bold" FontSize="12.5" BorderThickness="0" Margin="0,0,8,0" Click="BtnCapture_Click" ToolTip="Chụp ảnh hiện trạng thực tế, tự động làm sạch logo Google và vệt chữ chìm trên mặt đường"/>
                    <Button Content="⚙ Cài đặt" Padding="10,5" Background="#374151" Foreground="#E5E7EB" FontWeight="SemiBold" BorderThickness="0" Margin="0,0,6,0" Click="BtnAiSettings_Click" ToolTip="Cài đặt tùy chọn xử lý ảnh hiện trường &amp; AI"/>
                    <Button Content="⛶ Toàn màn hình" Padding="8,4" Background="#4F46E5" Foreground="White" BorderThickness="0" Margin="0,0,6,0" Click="BtnToggleFullScreen_Click" ToolTip="Bật / Tắt chế độ mở rộng toàn màn hình"/>
                    <Button Content="🔄 Tải lại" Padding="8,4" Background="#3F3F46" Foreground="White" BorderThickness="0" Margin="0,0,6,0" Click="BtnReload_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- WebView2 Browser Control -->
        <Border Grid.Row="1" Background="#09090B">
            <wv2:WebView2 x:Name="webView"/>
        </Border>

        <!-- Footer Bar -->
        <Border Grid.Row="2" Background="#18181B" Padding="10,6" BorderBrush="#27272A" BorderThickness="0,1,0,0">
            <DockPanel LastChildFill="False">
                <TextBlock x:Name="lblAiStatus" Text="💡 Mẹo: Rê chuột để xoay 360°, nhấp vào mũi tên trên đường để di chuyển. Bấm 'Chụp Ảnh Hiện Trạng' để lưu ảnh hiện trường sạch bóng." 
                           Foreground="#71717A" FontSize="11" VerticalAlignment="Center"/>
                <TextBlock x:Name="lblCrsInfo" DockPanel.Dock="Right" Text="VN-2000" Foreground="#E4E4E7" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>