<Window x:Class="AVMap.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cập Nhật AVMap - Bản Mới Trực Tiếp" 
        Height="480" Width="580"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow"
        ResizeMode="NoResize"
        Background="#F8FAFC"
        FontFamily="Segoe UI" FontSize="13">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#0F172A" CornerRadius="8" Padding="18,14" Margin="0,0,0,12">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <TextBlock x:Name="txtIcon" Text="🚀" FontSize="26" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="txtTitle" Text="ĐÃ CÓ BẢN CẬP NHẬT AVMAP MỚI!" FontSize="15" FontWeight="Bold" Foreground="White"/>
                        <TextBlock x:Name="lblVersionCompare" Text="Phiên bản mới: v1.2.0  •  Bản đang dùng: v1.1.0" FontSize="12" Foreground="#94A3B8" Margin="0,3,0,0"/>
                    </StackPanel>
                </StackPanel>
                <Border x:Name="badgeBorder" DockPanel.Dock="Right" Background="#065F46" CornerRadius="12" Padding="10,4" VerticalAlignment="Center">
                    <TextBlock x:Name="txtBadge" Text="CÓ BẢN MỚI" FontSize="11" FontWeight="Bold" Foreground="#34D399"/>
                </Border>
            </DockPanel>
        </Border>

        <!-- ChangeLog Content -->
        <Border Grid.Row="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="15">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="NỘI DUNG NÂNG CẤP &amp; TÍNH NĂNG MỚI:" FontSize="12" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,8"/>
                    <TextBlock x:Name="txtChangeLog" TextWrapping="Wrap" FontSize="12.5" Foreground="#334155" LineHeight="20"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Warning / Instructions -->
        <Border Grid.Row="2" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="ℹ" FontSize="16" FontWeight="Bold" Foreground="#2563EB" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock Text="Chỉ tải các file cập nhật cần thiết (~600 KB). Tự động đóng CAD, ghi đè file vào thư mục netload và mở lại CAD ngay lập tức!" 
                           FontSize="11.5" Foreground="#1E40AF" TextWrapping="Wrap" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Bottom Actions -->
        <DockPanel Grid.Row="3" Margin="0,15,0,0" LastChildFill="False">
            <Button Content="Để Sau" Width="100" Height="36" Background="#E2E8F0" BorderThickness="0" 
                    FontWeight="SemiBold" Cursor="Hand" Click="BtnLater_Click"/>
            <Button x:Name="btnUpdateNow" Content="⚡ Cập Nhật Tự Động Ngay" Width="220" Height="36" DockPanel.Dock="Right"
                    Background="#16A34A" Foreground="White" FontWeight="Bold" BorderThickness="0" 
                    Cursor="Hand" Click="BtnUpdateNow_Click"/>
        </DockPanel>
    </Grid>
</Window>