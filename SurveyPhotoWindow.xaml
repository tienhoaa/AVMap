<Window x:Class="AVMap.SurveyPhotoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chèn Ảnh Khảo Sát Hiện Trường - AVMap" 
        Height="700" Width="920"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResizeWithGrip"
        Background="#F8FAFC"
        FontFamily="Segoe UI" FontSize="13">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#0F172A" CornerRadius="8" Padding="16,12" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="📷" FontSize="26" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <StackPanel>
                    <TextBlock Text="CHÈN ẢNH KHẢO SÁT HIỆN TRƯỜNG (GPS VN-2000)" FontWeight="Bold" FontSize="15" Foreground="White"/>
                    <TextBlock Text="Tự động đọc tọa độ GPS từ ảnh điện thoại (iPhone HEIC / Android), vẽ mũi tên Leader cắm đúng vị trí hư hỏng" FontSize="12" Foreground="#94A3B8" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Source Selector (Tabs: Local vs Cloud) -->
        <TabControl Grid.Row="1" Margin="0,0,0,10" Background="Transparent" BorderBrush="#CBD5E1">
            <!-- Tab 1: Local Machine -->
            <TabItem Header=" 📂 Ảnh Trên Máy Tính / Thẻ Nhớ " FontWeight="SemiBold">
                <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1,0,1,1" Padding="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="📁 Chọn Thư Mục Ảnh" Height="32" Padding="12,0" Background="#0284C7" Foreground="White" FontWeight="Bold" BorderThickness="0" Click="BtnBrowseFolder_Click" Cursor="Hand"/>
                        <Button Grid.Column="2" Content="🖼️ Chọn Các Tệp Ảnh" Height="32" Padding="12,0" Background="#E2E8F0" Foreground="#1E293B" FontWeight="SemiBold" BorderThickness="0" Click="BtnBrowseFiles_Click" Cursor="Hand"/>
                        <TextBox Grid.Column="4" x:Name="txtLocalPath" Height="32" VerticalContentAlignment="Center" Padding="8,0" IsReadOnly="True" Foreground="#64748B" Text="Chưa chọn thư mục hoặc tệp nào..."/>
                    </Grid>
                </Border>
            </TabItem>

            <!-- Tab 2: Google Photos / Google Drive Cloud -->
            <TabItem Header=" ☁️ Link Google Photos / Google Drive " FontWeight="SemiBold">
                <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1,0,1,1" Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Dòng 1: Nhập link Cloud -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="🔗 Link Album / Drive:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#334155"/>
                        <TextBox Grid.Row="0" Grid.Column="2" x:Name="txtCloudUrl" Height="30" VerticalContentAlignment="Center" Padding="8,0" Foreground="#1E293B" Text=""/>
                        <Button Grid.Row="0" Grid.Column="4" Content="⚡ Tải Ảnh Từ Link" Height="30" Padding="16,0" Background="#0284C7" Foreground="White" FontWeight="Bold" BorderThickness="0" Click="BtnDownloadCloud_Click" Cursor="Hand"/>

                        <!-- Dòng 2: Nơi lưu ảnh tải về & Nút dọn cache -->
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="📁 Thư mục lưu ảnh:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#334155"/>
                        <Grid Grid.Row="2" Grid.Column="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" x:Name="txtSaveDir" Height="30" VerticalContentAlignment="Center" Padding="8,0" Foreground="#1E293B"/>
                            <Button Grid.Column="2" Content="Duyệt..." Height="30" Padding="12,0" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" Click="BtnBrowseSaveDir_Click" Cursor="Hand"/>
                        </Grid>
                        <Button Grid.Row="2" Grid.Column="4" x:Name="btnClearCache" Content="🧹 Dọn Cache Tạm" Height="30" Padding="12,0" Background="#FEF2F2" Foreground="#DC2626" BorderBrush="#FECACA" BorderThickness="1" FontWeight="SemiBold" Click="BtnClearCache_Click" Cursor="Hand" ToolTip="Xóa các file tạm tải về trong AppData để giải phóng ổ cứng"/>
                    </Grid>
                </Border>
            </TabItem>
        </TabControl>

        <!-- Photo Table (Grid.Row = 2) -->
        <Border Grid.Row="2" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- List Toolbar -->
                <DockPanel Grid.Row="0" Margin="0,0,0,8" LastChildFill="False">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                        <Button Content="✔ Chọn tất cả" Height="26" Padding="8,0" Margin="0,0,6,0" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" Click="BtnSelectAll_Click" Cursor="Hand"/>
                        <Button Content="✖ Bỏ chọn tất cả" Height="26" Padding="8,0" Margin="0,0,6,0" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" Click="BtnDeselectAll_Click" Cursor="Hand"/>
                        <Button Content="Chỉ chọn ảnh có GPS" Height="26" Padding="8,0" Background="#E0F2FE" Foreground="#0369A1" BorderBrush="#BAE6FD" BorderThickness="1" FontWeight="SemiBold" Click="BtnSelectOnlyGps_Click" Cursor="Hand"/>
                    </StackPanel>
                    <TextBlock x:Name="txtSummary" DockPanel.Dock="Right" Text="Tổng số: 0 ảnh | Có GPS: 0 ảnh" VerticalAlignment="Center" Foreground="#475569" FontWeight="SemiBold"/>
                </DockPanel>

                <!-- DataGrid -->
                <DataGrid Grid.Row="1" x:Name="dgPhotos" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" GridLinesVisibility="Horizontal" HeadersVisibility="Column" Background="White" RowHeight="28" BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn Header=" Chọn" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="50"/>
                        <DataGridTextColumn Header="Tên tệp ảnh" Binding="{Binding FileName}" Width="200" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Độ phân giải" Binding="{Binding Dimensions}" Width="90" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Loại ảnh" Binding="{Binding Format}" Width="70" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Tọa độ GPS (WGS84)" Binding="{Binding GpsCoords}" Width="150" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Tọa độ VN-2000 (X, Y)" Binding="{Binding Vn2000Coords}" Width="150" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Hướng nhìn" Binding="{Binding HeadingStr}" Width="85" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Ngày chụp" Binding="{Binding DateTakenStr}" Width="110" IsReadOnly="True"/>
                        <DataGridTemplateColumn Header="Trạng thái" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusColor}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Display Configuration on CAD (Grid.Row = 3) -->
        <GroupBox Grid.Row="3" Header=" Cấu hình hiển thị trên bản vẽ AutoCAD " FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,0,10" Padding="10">
            <StackPanel>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="65"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="65"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="65"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="65"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Rộng ảnh ngang (m):" VerticalAlignment="Center" FontWeight="Normal" Foreground="#475569"/>
                    <TextBox Grid.Column="1" x:Name="txtWidthLandscape" Text="15.0" Height="26" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Margin="5,0,0,0"/>

                    <TextBlock Grid.Column="3" Text="Cao ảnh dọc (m):" VerticalAlignment="Center" FontWeight="Normal" Foreground="#475569"/>
                    <TextBox Grid.Column="4" x:Name="txtHeightPortrait" Text="9.0" Height="26" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Margin="5,0,0,0"/>

                    <TextBlock Grid.Column="6" Text="Khoảng dạt lề (m):" VerticalAlignment="Center" FontWeight="Normal" Foreground="#475569"/>
                    <TextBox Grid.Column="7" x:Name="txtOffset" Text="15.0" Height="26" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Margin="5,0,0,0"/>

                    <TextBlock Grid.Column="9" Text="Giãn cách ảnh (m):" VerticalAlignment="Center" FontWeight="Normal" Foreground="#475569"/>
                    <TextBox Grid.Column="10" x:Name="txtSpacing" Text="3.0" Height="26" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Margin="5,0,0,0"/>
                </Grid>

                <Grid Margin="0,4,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox Grid.Column="0" x:Name="chkAutoAntiOverlap" Content="⚡ Tự động tính toán vị trí, giãn đều chống trùng/đè ảnh (Auto Anti-Overlap)" IsChecked="True" FontWeight="Bold" Foreground="#0284C7" VerticalAlignment="Center" Margin="0,0,20,0"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Hướng bố trí:" VerticalAlignment="Center" Foreground="#475569" Margin="0,0,8,0"/>
                        <ComboBox x:Name="cmbLayoutMode" SelectedIndex="0" Height="26" Width="180">
                            <ComboBoxItem Content="Tỏa đều thông minh (Radial)"/>
                            <ComboBoxItem Content="Dạt sang Phải (+X)"/>
                            <ComboBoxItem Content="Dạt sang Trái (-X)"/>
                            <ComboBoxItem Content="Dạt lên Trên (+Y)"/>
                            <ComboBoxItem Content="Dạt xuống Dưới (-Y)"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <WrapPanel Margin="0,4,0,0">
                    <CheckBox x:Name="chkDrawLeader" Content="Vẽ mũi tên Leader chỉ đúng tim hư hỏng" IsChecked="True" FontWeight="Normal" Margin="0,0,18,0"/>
                    <CheckBox x:Name="chkDrawRectang" Content="Vẽ khung viền chữ nhật bao quanh ảnh" IsChecked="True" FontWeight="Normal" Margin="0,0,18,0"/>
                    <CheckBox x:Name="chkDrawLabel" Content="Ghi chú tên ảnh và ngày giờ chụp" IsChecked="True" FontWeight="Normal" Margin="0,0,18,0"/>
                    <CheckBox x:Name="chkAutoOrient" Content="Tự động xoay ảnh chuẩn chiều chụp (Auto-Orient iPhone/Android)" IsChecked="True" FontWeight="Normal"/>
                </WrapPanel>
            </StackPanel>
        </GroupBox>

        <!-- Footer (Grid.Row = 4) -->
        <Grid Grid.Row="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Progress Bar & Status -->
            <StackPanel Grid.Row="0" Margin="0,0,0,8">
                <ProgressBar x:Name="pbProgress" Height="8" IsIndeterminate="False" Visibility="Collapsed" Margin="0,0,0,4"/>
                <TextBlock x:Name="txtStatus" Text="Sẵn sàng quét ảnh khảo sát..." FontSize="12" Foreground="#64748B"/>
            </StackPanel>

            <DockPanel Grid.Row="1" LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button Content="Đóng" Width="90" Height="34" Margin="0,0,10,0" Background="#E2E8F0" Foreground="#334155" FontWeight="SemiBold" BorderThickness="0" Click="BtnClose_Click" Cursor="Hand"/>
                    <Button x:Name="btnInsert" Content="🚀 CHÈN VÀO AUTOCAD" Width="220" Height="34" Background="#0284C7" Foreground="White" FontWeight="Bold" BorderThickness="0" Click="BtnInsert_Click" Cursor="Hand"/>
                </StackPanel>
            </DockPanel>
        </Grid>
    </Grid>
</Window>
